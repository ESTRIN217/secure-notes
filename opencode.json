{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "kotlin-lsp": {
      "command": ["/opt/kotlin-server/current/bin/intellij-server", "--stdio"],
      "extensions": [".kt", ".kts", ".java"]
    }
  },
  "mcp": { 
     "context7": { 
       "type": "remote", 
       "url": "https://mcp.context7.com/mcp", 
       "headers": { 
         "CONTEXT7_API_KEY": "<TU APIKEY DE CONTEXT7>" 
       } 
     }
   },
  "plugins": ["context-mode"]
}
